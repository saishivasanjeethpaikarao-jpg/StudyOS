# ==============================================================================
# StudyOS API — Comprehensive Environment Configuration Template
# ==============================================================================
# Use this template to create .env for local development or configure secrets in
# Cloudflare Workers via `wrangler secret put <KEY>`.
#
# Classification Legend:
#   [REQ-LOCAL]  Required for local Node.js / Docker execution
#   [REQ-EDGE]   Required for Cloudflare Worker runtime
#   [OPTIONAL]   Optional feature integration (fails gracefully if omitted)
#   [SECRET]     Sensitive secret — NEVER commit to version control
#   [PUBLIC]     Non-sensitive configuration / URL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# [REQ-LOCAL] [PUBLIC] Local HTTP server port
PORT=3001

# [REQ-LOCAL] [REQ-EDGE] [PUBLIC] Environment mode ('development' | 'production' | 'test')
NODE_ENV=development

# [REQ-LOCAL] [REQ-EDGE] [PUBLIC] Base API URL (used for OAuth redirects and webhook callbacks)
# Local: http://localhost:3001 | Production: https://api.studyos.com
API_URL=http://localhost:3001

# [REQ-LOCAL] [REQ-EDGE] [PUBLIC] Web Application Frontend URL
# Local: http://localhost:3000 | Production: https://app.studyos.com
WEB_APP_URL=http://localhost:3000

# [REQ-LOCAL] [REQ-EDGE] [PUBLIC] Allowed CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://app.studyos.com

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# [REQ-LOCAL] [SECRET] Local PostgreSQL connection string (Docker dev stack: port 5431)
DATABASE_URL=postgresql://opensunsama:opensunsama@localhost:5431/opensunsama

# [OPTIONAL] [SECRET] Dedicated database for isolated test execution (defaults to DATABASE_URL if unset)
TEST_DATABASE_URL=postgresql://opensunsama:opensunsama@localhost:5431/opensunsama

# [REQ-EDGE] [SECRET] Supabase PostgreSQL connection string for production Hyperdrive upstream (port 6543 Supavisor)
# SUPABASE_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# [OPTIONAL] [SECRET] Local Hyperdrive emulation connection string for `wrangler dev`
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://opensunsama:opensunsama@127.0.0.1:5431/opensunsama

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & MASTER ENCRYPTION
# ------------------------------------------------------------------------------
# [REQ-LOCAL] [REQ-EDGE] [SECRET] JWT signing key (minimum 32 random characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-secure-random-32-char-string-minimum

# [OPTIONAL] [PUBLIC] JWT token expiration window (defaults to 7d)
JWT_EXPIRES_IN=7d

# [OPTIONAL] [PUBLIC] Refresh token renewal leeway days (defaults to 30)
JWT_REFRESH_LEEWAY_DAYS=30

# [REQ-LOCAL] [REQ-EDGE] [SECRET] Master AES-256-GCM encryption key for credentials at rest
# Exactly 32 bytes (64 hex characters)
# Generate with: openssl rand -hex 32
STUDYOS_SECRET_KEY=replace-with-64-character-hex-string-for-aes-256-gcm-master-key

# [OPTIONAL] [SECRET] Legacy calendar credentials encryption key (64 hex characters)
CALENDAR_ENCRYPTION_KEY=replace-with-64-character-hex-string-for-calendar-tokens

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE WORKER & CRON SCHEDULER
# ------------------------------------------------------------------------------
# [REQ-EDGE] [SECRET] Shared authentication token for securing Cloudflare Cron Trigger tick endpoints
# Required for /workers/automations/tick and /workers/rollover/tick (FAILS CLOSED if unset)
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-random-cron-secret-token

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (SUPABASE STORAGE / CLOUDFLARE R2 / AWS S3)
# ------------------------------------------------------------------------------
# [OPTIONAL] [PUBLIC] Storage Provider Selection ('supabase' | 'r2' | 's3')
# Default auto-detects based on AWS_ENDPOINT_URL hostname.
STORAGE_PROVIDER=supabase

# --- Option A: Supabase Storage S3-Compatible Endpoint (100% Cardless Free Tier) ---
# Project ref found in Supabase Dashboard -> Project Settings -> General
# S3 Credentials generated in Supabase Dashboard -> Project Settings -> Storage -> S3 Credentials
# Endpoint format: https://<project-ref>.storage.supabase.co/storage/v1/s3 (or https://<project-ref>.supabase.co/storage/v1/s3)
SUPABASE_STORAGE_S3_ENDPOINT=https://replace-with-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_BUCKET=studyos-files
SUPABASE_STORAGE_ACCESS_KEY_ID=replace-with-supabase-storage-access-key-id
SUPABASE_STORAGE_SECRET_ACCESS_KEY=replace-with-supabase-storage-secret-access-key
SUPABASE_STORAGE_REGION=ap-south-1

# --- Option B: Cloudflare R2 / AWS S3 Fallback Configuration ---
AWS_S3_BUCKET=studyos-files
R2_BUCKET_NAME=studyos-files
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
AWS_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com
AWS_REGION=auto

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH & CLOUD SERVICES
# ------------------------------------------------------------------------------
# [OPTIONAL] [PUBLIC] Google Cloud OAuth Client ID (Required for Google Sign-In & Calendar sync)
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com

# [OPTIONAL] [SECRET] Google Cloud OAuth Client Secret
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# ------------------------------------------------------------------------------
# 7. TELEGRAM BOT NOTIFICATIONS
# ------------------------------------------------------------------------------
# [OPTIONAL] [SECRET] Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token

# [OPTIONAL] [SECRET] Telegram webhook verification secret token
TELEGRAM_SECRET_TOKEN=replace-with-telegram-secret-token

# ------------------------------------------------------------------------------
# 8. AI PROVIDERS (STUDY PLANNER & MATERIAL INGESTION)
# ------------------------------------------------------------------------------
# [OPTIONAL] [SECRET] Google Gemini API Key
GEMINI_API_KEY=replace-with-gemini-api-key

# [OPTIONAL] [SECRET] Groq Cloud API Key
GROQ_API_KEY=replace-with-groq-api-key

# [OPTIONAL] [SECRET] NVIDIA NIM API Key
NVIDIA_NIM_API_KEY=replace-with-nvidia-nim-api-key

# ------------------------------------------------------------------------------
# 9. HYBRID HERMES AGENT & BACKGROUND WORKERS
# ------------------------------------------------------------------------------
# [OPTIONAL] [SECRET] Hermes Agent bearer authentication token
HERMES_AGENT_TOKEN=replace-with-hermes-agent-token

# [OPTIONAL] [PUBLIC] Enable or disable automatic task rollover at midnight (defaults to true)
ROLLOVER_ENABLED=true

# [OPTIONAL] [SECRET] Local Redis connection string (port 6379)
REDIS_URL=redis://localhost:6379

# [OPTIONAL] [SECRET] Resend API key for transactional emails
RESEND_API_KEY=replace-with-resend-api-key

# [OPTIONAL] [PUBLIC] Web Push VAPID Public Key
VAPID_PUBLIC_KEY=replace-with-vapid-public-key

# [OPTIONAL] [SECRET] Web Push VAPID Private Key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key

# [OPTIONAL] [PUBLIC] Web Push Subject (mailto: or URL)
VAPID_SUBJECT=mailto:admin@studyos.com
